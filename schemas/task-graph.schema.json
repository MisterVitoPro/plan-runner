{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-graph.schema.json",
  "title": "Plan Runner Task Graph",
  "description": "Validated, stable-ID dependency graph emitted for DAG execution. The scheduler must additionally reject unknown, self-referential, cyclic, or duplicate task IDs before dispatch; those graph-wide invariants cannot be expressed by JSON Schema alone.",
  "type": "object",
  "required": ["source_plan", "context7_available", "tasks", "uncovered_plan_sections"],
  "properties": {
    "source_plan": {"type": "string"},
    "context7_available": {"type": "boolean"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    },
    "uncovered_plan_sections": {"type": "array", "items": {"type": "string"}},
    "token_usage": {"$ref": "#/$defs/tokenUsage"}
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": ["task_id", "task_title", "task_excerpt_lines", "depends_on", "owned_files", "acceptance_criteria", "recommended_model", "verification_scope"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "description": "Stable run-local identifier. It is never renumbered when a task is retried or scheduled in a different ready set."},
        "task_title": {"type": "string", "minLength": 1},
        "task_excerpt_lines": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"},
        "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}, "uniqueItems": true},
        "owned_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "recommended_model": {"type": "string", "enum": ["haiku", "sonnet", "opus"]},
        "role": {"type": "string", "enum": ["test-author", "impl", "standalone"]},
        "testable": {"type": "boolean"},
        "tests_to_satisfy": {"type": "array", "items": {"type": "string"}},
        "verification_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "risk": {"type": "string", "enum": ["low", "medium", "high"]},
        "shared_files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "tokenUsage": {
      "type": ["object", "null"],
      "properties": {
        "input": {"type": ["integer", "null"]},
        "output": {"type": ["integer", "null"]},
        "total": {"type": ["integer", "null"]}
      }
    }
  }
}
